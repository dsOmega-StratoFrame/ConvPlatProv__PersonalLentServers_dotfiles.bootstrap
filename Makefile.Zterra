# Manual testing for the zterra namespace (roles: zterra_mount, zterra_layout,
# zterra_binds, zterra_docker_data) — the `zterra`/`storage` tags of
# HomeServer__HomeAssistant.yml and deploy-nikolaigogol.yml.
#
# See Makefile.Steps for the target list and INVENTORY selection.
#   INVENTORY=hosts.ini                       -> real @terra (E2E)
#   INVENTORY=tests/integration/inventory.ini -> mock container
STEP_TAGS := zterra
include Makefile.Steps
