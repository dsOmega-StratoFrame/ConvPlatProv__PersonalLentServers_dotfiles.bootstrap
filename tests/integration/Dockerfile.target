# Mock @terra for integration tests.
#
# Mirrors the relevant properties of TerraMaster TOS 6: an Ubuntu-22.04-
# compatible rootfs managed by systemd, with a superuser admin account named
# "terra". It is intentionally *not* TOS itself — it exists so the Ansible roles
# can be exercised end to end without touching the real NAS.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd \
      systemd-sysv \
      openssh-server \
      sudo \
      python3 \
      ca-certificates \
      curl \
      xz-utils \
      rsync \
      gnupg \
    && rm -rf /var/lib/apt/lists/*

# Admin account mirroring @terra (TOS 6's first account is a superuser).
RUN useradd -m -s /bin/bash terra \
    && echo 'terra:terra' | chpasswd \
    && usermod -aG sudo terra \
    && echo 'terra ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/terra \
    && chmod 0440 /etc/sudoers.d/terra

# Enable SSH; password auth is allowed so the first bootstrap can run, exactly
# like a freshly-enabled TOS device.
RUN mkdir -p /var/run/sshd \
    && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config \
    && ln -sf /lib/systemd/system/ssh.service /etc/systemd/system/multi-user.target.wants/ssh.service

EXPOSE 22
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
