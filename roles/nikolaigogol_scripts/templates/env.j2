PROJECT_NAME=HomeServer__HomeAssistant
SYSTEM_NAME=NikolaiGogol
BOOKMARKS=/zterra
UNIX_DOTFILES={{ nixos_container_unix_dotfiles_dir }}
VIRT_SCRIPTS_BOOTSTRAP={{ nixos_container_virt_scripts_dir }}
HOME_ASSISTANT_IMAGE={{ nixos_container_home_assistant_image }}
CONTAINER_USERNAME={{ nixos_container_username }}
NAMESPACE=ds-omega
IMAGE_BASE_NAME=nikolai-gogol
IMAGE_TAG=latest
# docker compose resolves `image: ${IMAGE_NAME}` from this file, not from the
# Makefile. Upstream `import-nixos` publishes the content tag as the deployment
# identity and keeps :latest only as a debug alias.
IMAGE_NAME={{ nixos_container_image_repository | default('ds-omega/nikolai-gogol') }}:latest
CONTAINER_NAME={{ nixos_container_name }}
