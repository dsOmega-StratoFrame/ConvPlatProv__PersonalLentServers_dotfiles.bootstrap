' ============================================================================
' Manilov__FlowOwnership__ManilovToInternet.puml
'
' Purpose : Flow F1 — @Manilov -> house router -> internet, told as ownership,
'           not as rules. Four levels, stacked, each readable on its own:
'             L0 intent       one arrow, and why the host is on the path
'             L1 logical      VM -> container -> host -> LAN as boxes
'             L2 segments     who controls each surface; the hand-off is explicit
'             L3 checkpoints  who may write / read / grant; where a stop happens
' Source  : docs/adr/0006-ManilovNetworkOwnership.md — D1, D1.1, D4, D4a, D4b.
' Style   : companion to Manilov__ForwardJumpSequence__ELI5.puml. Same truth,
'           stated as ownership. Colour = owner; one shared legend.
' Render  : plantuml -tpng -tsvg docs/_diagrams/Manilov__FlowOwnership__ManilovToInternet.puml
' ============================================================================

@startuml
!include _shared/ManilovFlowOwnershipCommon.puml

title F1 — @Manilov -> house router -> internet\nownership flow, L0 to L3 (colour = owner)

rectangle "**L0**\nINTENT" as T0 OWN_LABEL
rectangle "**L1**\nLOGICAL" as T1 OWN_LABEL
rectangle "**L2**\nSEGMENTS\nAND HAND-OFFS" as T2 OWN_LABEL
rectangle "**L3**\nCHECKPOINTS\nVM side, then host" as T3 OWN_LABEL
rectangle "CHECKPOINT 1\nVM side\n«NixOS image»" as K1 OWN_LABEL
rectangle "CHECKPOINT 2\nhost side" as K2 OWN_LABEL

' -- L0: one arrow, and why the host is involved -----------------------------
rectangle "@Manilov\nwants the internet\n«@Manilov»" as a0 OWN_AM
rectangle "the internet\nbehind the house router\n«house LAN»" as b0 OWN_HL

' -- L1: the boxes the flow passes through ------------------------------------
rectangle "@Manilov VM\n«@Manilov»" as a1 OWN_AM
rectangle "NixOS in @NikolaiGogol\ncontainer, host netns\n«NixOS image»" as c1 OWN_NG
rectangle "TOS on @terra\nhost\n«TOS on @terra»" as h1 OWN_TOS
rectangle "house LAN / router\n«house LAN»" as n1 OWN_HL

' -- L2: the surfaces that carry the flow, each with its controller -----------
rectangle "virtio NIC\n«@Manilov»" as s1 OWN_AM
rectangle "VM tap\n«NixOS image»" as s2 OWN_NG
rectangle "br0 — bridge, L3, MAC pin\n«NixOS image»" as s3 OWN_NG
rectangle "eth1 on this path\nL2 membership + L3\n«NixOS image»" as s4 OWN_NG
rectangle "HAND-OFF\nNIC hardware: TOS\nL2 + L3: image" as shr OWN_MARK
rectangle "eth1 — NIC + driver\n«TOS on @terra»" as s5 OWN_TOS
rectangle "house L2 segment\n«house LAN»" as s6 OWN_HL
rectangle "router, gateway, DHCP\n«house LAN»" as s7 OWN_HL

' -- L3: two checkpoints, owner labels only -----------------------------------
rectangle "writer: image «NixOS»\neffect: stop only" as k1a OWN_NG
rectangle "grant: none here\nthe image cannot permit" as k1b OWN_NG
rectangle "STOP: image may stop here" as k1c OWN_NG
rectangle "gate writer: TOS\ndefault answer: no" as k2a OWN_TOS
rectangle "GRANT: MANILOV_FORWARD\n«bootstrap», lifecycle 24/7" as k2b OWN_BR
rectangle "reader: image «NixOS»\nread-only, fails closed" as k2c OWN_NG
rectangle "STOP: the host default\nmay stop here" as k2d OWN_TOS
rectangle "Docker chains — live order\nmay stop its own traffic" as k2e OWN_DK

$OwnershipLegend()

' -- the title spine: hidden vertical links fix the stacking order ------------
T0 -[hidden]down-> T1
T1 -[hidden]down-> T2
T2 -[hidden]down-> T3
T3 -[hidden]down-> K1
K1 -[hidden]down-> K2
K2 -[hidden]down-> LGH

' -- L0 row ------------------------------------------------------------------
T0 -[hidden]right-> a0
a0 -right-> b0 : only route out — the host owns the uplink

' -- L1 row ------------------------------------------------------------------
T1 -[hidden]right-> a1
a1 -right-> c1
c1 -right-> h1
h1 -right-> n1

' -- L2 row ------------------------------------------------------------------
T2 -[hidden]right-> s1
s1 -right-> s2
s2 -right-> s3
s3 -right-> s4
s4 -[#B26A00]right-> shr
shr -[#B26A00]right-> s5
s5 -right-> s6
s6 -right-> s7

' -- L3 row 1: VM-side checkpoint --------------------------------------------
K1 -[hidden]right-> k1a
k1a -[hidden]right-> k1b
k1b -[hidden]right-> k1c

' -- L3 row 2: host-side checkpoint ------------------------------------------
K2 -[hidden]right-> k2a
k2a -[hidden]right-> k2b
k2b -[hidden]right-> k2c
k2c -[hidden]right-> k2d
k2d -[hidden]right-> k2e

@enduml
